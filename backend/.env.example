# Which LLM provider to use for generation + agent tool-calling: "anthropic", "openai", or "gemini"
LLM_PROVIDER=gemini

# Only the one matching LLM_PROVIDER above needs to be set.
# Gemini is genuinely free (no credit card) via https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# Models
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# Embeddings: "gemini" (default — lightweight, uses your Gemini API key,
# safe for low-memory hosting) or "local" (sentence-transformers, needs
# `pip install -r requirements-local-embeddings.txt` first, heavier on RAM,
# best for your own machine rather than free-tier hosting).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Storage
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
SQLITE_PATH=./data/ragforge.db

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
